{
  "name": "elnemer/nemr-apex-omni",
  "description": "Enterprise-grade PHP 8.3 & Full-Stack AI Engineering Framework with Zero-Dependency QueryBuilder, REST Router, and Payment Handlers",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Mahmoud ElNeMeR",
      "email": "contact@elnemer-ai.com",
      "homepage": "https://elnemer-ai.com"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Nemr\\Apex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nemr\\Apex\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
